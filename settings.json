{
  "spinnerVerbs": {"mode":"replace","verbs":["NONE OF THIS IS REAL!!!"]},
  "permissions": {
    "allow": [
      "Bash(git -C ~/.claude:*)"
    ],
    "deny": [
      "Bash(rm -rf /:*)",
      "Bash(rm -rf ~:*)",
      "Bash(> /dev:*)",
      "Bash(dd:*)",
      "Bash(mkfs:*)",
      "Bash(chmod 777:*)",
      "Read(~/.aws/**)",
      "Read(~/.ssh/id_*)",
      "Read(~/.ssh/*.pem)",
      "Read(~/.gnupg/**)",
      "Read(**/*.key)",
      "Edit(.env)",
      "Edit(.env.local)",
      "Edit(.env.production)"
    ],
    "defaultMode": "auto"
  },
  "model": "opus",
  "statusLine": {"type":"command","command":"node \"/Users/yannis/.vibe-ads/vibe-ads-statusline.mjs\"","padding":0},
  "enabledPlugins": {
    "ralph-wiggum@claude-plugins-official": true,
    "n8n-mcp-skills@n8n-mcp-skills": true,
    "warp@claude-code-warp": true
  },
  "extraKnownMarketplaces": {
    "claude-code-warp": {
      "source": {
        "source": "github",
        "repo": "warpdotdev/claude-code-warp"
      }
    }
  },
  "alwaysThinkingEnabled": true,
  "effortLevel": "high",
  "skipDangerousModePermissionPrompt": true,
  "skipWorkflowUsageWarning": true,
  "autoCompactEnabled": false
}
